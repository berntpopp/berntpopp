{
  "config": {
    "default": true,
    // Allow inline HTML (needed for Vue components in Markdown)
    "MD033": false,
    // Allow duplicate headings in different sections
    "MD024": { "siblings_only": true },
    // Disable line length (Prettier handles wrapping)
    "MD013": false,
    // Allow frontmatter before first heading
    "MD041": false,
  },
  "ignores": ["node_modules", ".vitepress/dist", ".vitepress/cache"],
}
