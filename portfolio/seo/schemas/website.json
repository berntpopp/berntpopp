{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{siteUrl}}/#website",
  "url": "{{siteUrl}}",
  "name": "{{site.title}} - {{person.jobTitle}}",
  "description": "{{site.description}}",
  "publisher": {
    "@id": "{{siteUrl}}/#person"
  },
  "inLanguage": ["en", "de"],
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{siteUrl}}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}