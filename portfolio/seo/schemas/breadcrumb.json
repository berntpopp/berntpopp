{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{siteUrl}}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{pageName}}",
      "item": "{{pageUrl}}"
    }
  ]
}