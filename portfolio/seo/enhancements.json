{
  "additionalSchemas": {
    "ResearchProject": {
      "description": "Schema for research projects like SysNDD, HNF1B-db",
      "properties": {
        "@context": "https://schema.org",
        "@type": "ResearchProject",
        "name": "{{projectName}}",
        "description": "{{projectDescription}}",
        "url": "{{projectUrl}}",
        "funder": {
          "@type": "Organization",
          "name": "{{funderName}}"
        },
        "member": {
          "@id": "{{siteUrl}}/#person"
        }
      }
    },
    "MedicalScholarlyArticle": {
      "description": "Enhanced schema for individual publications",
      "properties": {
        "@context": "https://schema.org",
        "@type": "MedicalScholarlyArticle",
        "headline": "{{title}}",
        "author": "{{authors}}",
        "datePublished": "{{year}}",
        "isPartOf": {
          "@type": "PublicationIssue",
          "isPartOf": {
            "@type": "Periodical",
            "name": "{{journal}}"
          }
        },
        "identifier": [
          {
            "@type": "PropertyValue",
            "propertyID": "DOI",
            "value": "{{doi}}"
          },
          {
            "@type": "PropertyValue",
            "propertyID": "PMID",
            "value": "{{pmid}}"
          }
        ]
      }
    }
  },
  "multilingual": {
    "enabled": true,
    "languages": ["en", "de"],
    "hreflang": {
      "en": {
        "url": "https://berntpopp.com",
        "locale": "en_US"
      },
      "de": {
        "url": "https://berntpopp.com/de",
        "locale": "de_DE"
      }
    },
    "germanContent": {
      "person": {
        "jobTitle": "Oberarzt & Facharzt für Humangenetik",
        "description": "Facharzt für Humangenetik mit Spezialisierung auf seltene Erkrankungen, neurologische Entwicklungsstörungen und klinische Genomik"
      },
      "keywords": {
        "local": [
          "Facharzt Humangenetik Berlin",
          "Genetiker Berlin",
          "Seltene Krankheiten Berlin",
          "Genetische Beratung Berlin"
        ]
      }
    }
  },
